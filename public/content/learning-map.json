{
  "chapters": [
    {
      "id": "basics",
      "title": { "ja": "C# 基礎", "en": "C# Basics" },
      "description": { "ja": "変数、条件分岐、ループ、メソッド、配列まで。まずここから。", "en": "Variables, control flow, methods, and arrays. Start here." },
      "nodes": [
        { "id": "program-entry", "code": "Console.WriteLine(\"Hello, World!\");", "lane": 1 },
        { "id": "variables-assignment", "code": "int a = 10;", "prerequisites": ["program-entry"], "lane": 1 },
        { "id": "numeric-types", "code": "double x = 3.14;", "prerequisites": ["variables-assignment"], "lane": 0 },
        { "id": "boolean-operators", "code": "bool ok = a > 0 && b > 0;", "prerequisites": ["variables-assignment"], "lane": 2 },
        { "id": "if-else", "code": "if (score >= 60) { ... }", "prerequisites": ["boolean-operators"], "lane": 2 },
        { "id": "while-do-loops", "code": "while (i < 10) { i++; }", "prerequisites": ["if-else"], "lane": 3 },
        { "id": "methods-parameters-returns", "code": "int Add(int a, int b) => a + b;", "prerequisites": ["variables-assignment"], "lane": 1 },
        { "id": "arrays-basics", "code": "int[] nums = { 1, 2, 3 };", "prerequisites": ["while-do-loops", "methods-parameters-returns"], "lane": 1 },
        { "id": "string-literals", "code": "string name = \"Alice\";", "prerequisites": ["variables-assignment"], "lane": 4 },
        { "id": "index-out-of-range", "kind": "support", "attachedTo": "arrays-basics", "lane": 3 }
      ]
    },
    {
      "id": "types-oop",
      "title": { "ja": "型・クラス設計", "en": "Types & Object Design" },
      "description": { "ja": "参照型、プロパティ、record、interface、ジェネリックなど、C# の型設計を学ぶ。", "en": "Reference types, properties, records, interfaces, generics, and object design." },
      "nodes": [
        { "id": "value-reference-types", "code": "int n = 1; Person p = new();", "lane": 1 },
        { "id": "properties", "code": "public string Name { get; set; }", "prerequisites": ["value-reference-types"], "lane": 0 },
        { "id": "records", "code": "record Person(string Name, int Age);", "prerequisites": ["properties"], "lane": 0 },
        { "id": "interfaces", "code": "class Cat : IAnimal { ... }", "prerequisites": ["value-reference-types"], "lane": 2 },
        { "id": "generics", "code": "List<int> numbers = new();", "prerequisites": ["interfaces"], "lane": 2 },
        { "id": "delegates", "code": "Func<int, int> f = x => x * 2;", "prerequisites": ["value-reference-types"], "lane": 4 },
        { "id": "events", "code": "button.Click += OnClick;", "prerequisites": ["delegates"], "lane": 4 },
        { "id": "pattern-matching", "code": "if (obj is string s) { ... }", "prerequisites": ["value-reference-types"], "lane": 3 },
        { "id": "invalid-cast", "kind": "support", "attachedTo": "pattern-matching", "lane": 5 }
      ]
    },
    {
      "id": "collections-linq",
      "title": { "ja": "コレクション・LINQ", "en": "Collections & LINQ" },
      "description": { "ja": "List、HashSet、IEnumerable、ラムダ式から LINQ へ進む。", "en": "Move from List, HashSet, IEnumerable, and lambdas into LINQ." },
      "nodes": [
        { "id": "list-basic", "code": "var list = new List<int> { 1, 2, 3 };", "lane": 1 },
        { "id": "hashset-basic", "code": "var set = new HashSet<int>();", "prerequisites": ["list-basic"], "lane": 0 },
        { "id": "ienumerable", "code": "IEnumerable<int> xs = list;", "prerequisites": ["list-basic"], "lane": 2 },
        { "id": "lambda", "code": "x => x * 2", "prerequisites": ["ienumerable"], "lane": 2 },
        { "id": "list-filter", "code": "var even = list.Where(x => x % 2 == 0);", "prerequisites": ["lambda"], "lane": 1 },
        { "id": "linq-select", "code": "var names = users.Select(x => x.Name);", "prerequisites": ["lambda"], "lane": 3 },
        { "id": "linq-deferred", "code": "var query = list.Where(x => x > 0);", "prerequisites": ["list-filter", "linq-select"], "lane": 2 },
        { "id": "linq-groupby", "code": "var groups = items.GroupBy(x => x.Category);", "prerequisites": ["linq-deferred"], "lane": 1 },
        { "id": "linq-distinct", "code": "var unique = list.Distinct();", "prerequisites": ["hashset-basic", "linq-deferred"], "lane": 3 },
        { "id": "invalid-operation", "kind": "support", "attachedTo": "linq-deferred", "lane": 4 }
      ]
    },
    {
      "id": "exceptions-debugging",
      "title": { "ja": "例外・デバッグ", "en": "Exceptions & Debugging" },
      "description": { "ja": "例外処理と null 周りの事故を、頻出トラブルと一緒に学ぶ。", "en": "Learn exception handling and null safety alongside common failures." },
      "nodes": [
        { "id": "try-catch", "code": "try { ... }\ncatch (Exception ex) { ... }", "lane": 1 },
        { "id": "nullable", "code": "string? name = null;", "prerequisites": ["try-catch"], "lane": 0 },
        { "id": "nullable-value-types", "code": "int? count = null;", "prerequisites": ["nullable"], "lane": 0 },
        { "id": "pattern-matching", "code": "if (value is int n) { ... }", "prerequisites": ["nullable"], "lane": 2 },
        { "id": "argument-null", "kind": "support", "attachedTo": "nullable", "lane": 3 },
        { "id": "nullref", "kind": "support", "attachedTo": "nullable", "lane": 4 },
        { "id": "format-exception", "kind": "support", "attachedTo": "try-catch", "lane": 5 },
        { "id": "invalid-cast", "kind": "support", "attachedTo": "pattern-matching", "lane": 6 }
      ]
    },
    {
      "id": "io-network",
      "title": { "ja": "I/O・ネットワーク", "en": "I/O & Networking" },
      "description": { "ja": "ファイル、JSON、HTTP と、リソースの正しい扱い方。", "en": "Files, JSON, HTTP, and correct resource lifetime management." },
      "nodes": [
        { "id": "idisposable", "code": "using var stream = File.OpenRead(path);", "lane": 1 },
        { "id": "file-write", "code": "File.WriteAllText(path, text);", "prerequisites": ["idisposable"], "lane": 0 },
        { "id": "directory-enumerate", "code": "Directory.EnumerateFiles(path)", "prerequisites": ["idisposable"], "lane": 2 },
        { "id": "json-write", "code": "JsonSerializer.Serialize(value);", "prerequisites": ["file-write"], "lane": 0 },
        { "id": "http-get", "code": "await client.GetStringAsync(url);", "prerequisites": ["idisposable"], "lane": 3 },
        { "id": "io-exception", "kind": "support", "attachedTo": "file-write", "lane": 4 },
        { "id": "directory-not-found", "kind": "support", "attachedTo": "directory-enumerate", "lane": 5 },
        { "id": "unauthorized-access", "kind": "support", "attachedTo": "file-write", "lane": 6 },
        { "id": "object-disposed", "kind": "support", "attachedTo": "idisposable", "lane": 7 }
      ]
    },
    {
      "id": "async-concurrency",
      "title": { "ja": "async・並行処理", "en": "Async & Concurrency" },
      "description": { "ja": "Task、async/await、待機、キャンセルを順番に理解する。", "en": "Understand Task, async/await, delays, and cancellation in order." },
      "nodes": [
        { "id": "task", "code": "Task<int> work = GetValueAsync();", "lane": 1 },
        { "id": "async-await", "code": "var data = await LoadAsync();", "prerequisites": ["task"], "lane": 1 },
        { "id": "task-delay", "code": "await Task.Delay(1000);", "prerequisites": ["async-await"], "lane": 0 },
        { "id": "cancellation-token", "code": "await WorkAsync(token);", "prerequisites": ["async-await"], "lane": 2 },
        { "id": "operation-canceled", "kind": "support", "attachedTo": "cancellation-token", "lane": 4 }
      ]
    },
    {
      "id": "practical",
      "title": { "ja": "実践テクニック", "en": "Practical Techniques" },
      "description": { "ja": "文字列、日時、正規表現、タプルなど、実装でよく使う道具を広げる。", "en": "Expand into strings, dates, regex, tuples, and other practical tools." },
      "nodes": [
        { "id": "string-interpolation", "code": "$\"Hello, {name}!\"", "lane": 1 },
        { "id": "string-split-join", "code": "string.Join(\", \", text.Split(','));", "prerequisites": ["string-interpolation"], "lane": 0 },
        { "id": "date-format", "code": "now.ToString(\"yyyy-MM-dd\");", "prerequisites": ["string-interpolation"], "lane": 2 },
        { "id": "regex-basic", "code": "Regex.IsMatch(text, @\"^\\d+$\")", "prerequisites": ["string-split-join"], "lane": 0 },
        { "id": "tuples-deconstruction", "code": "var (x, y) = point;", "prerequisites": ["string-interpolation"], "lane": 3 },
        { "id": "enums-flags", "code": "[Flags] enum Permission { Read = 1, Write = 2 }", "prerequisites": ["tuples-deconstruction"], "lane": 3 },
        { "id": "pattern-matching", "code": "var n = value switch { int x => x, _ => 0 };", "prerequisites": ["tuples-deconstruction"], "lane": 4 },
        { "id": "format-exception", "kind": "support", "attachedTo": "date-format", "lane": 5 }
      ]
    }
  ]
}
