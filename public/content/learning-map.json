    {
      "id": "async-concurrency",
      "title": { "ja": "async・並行処理", "en": "Async & Concurrency" },
      "description": { "ja": "Task、async/await、待機、キャンセルを順番に理解する。", "en": "Understand Task, async/await, delays, and cancellation in order." },
      "nodes": [
        { "id": "task", "code": "Task<int> work = GetValueAsync();", "lane": 1 },
        { "id": "async-await", "code": "var data = await LoadAsync();", "prerequisites": ["task"], "lane": 1 },
        { "id": "task-whenall-results", "code": "var results = await Task.WhenAll(tasks);", "prerequisites": ["async-await"], "lane": 0 },
        { "id": "semaphore-slim-limit", "code": "await gate.WaitAsync(token);\ntry { await WorkAsync(); } finally { gate.Release(); }", "prerequisites": ["task-whenall-results"], "lane": 0 },
        { "id": "async-enumerable-streaming", "code": "await foreach (var item in StreamAsync(token)) Process(item);", "prerequisites": ["async-await"], "lane": 3 },
        { "id": "synchronization-context", "code": "await LoadAsync(); // continuation may resume on the captured context", "prerequisites": ["async-await"], "lane": 4 },
        { "id": "task-delay", "code": "await Task.Delay(1000);", "prerequisites": ["async-await"], "lane": 1 },
        { "id": "cancellation-token", "code": "await WorkAsync(token);", "prerequisites": ["async-await"], "lane": 2 },
        { "id": "cancellation-timeout", "code": "using var cts = CancellationTokenSource.CreateLinkedTokenSource(token);\ncts.CancelAfter(TimeSpan.FromSeconds(5));", "prerequisites": ["cancellation-token"], "lane": 2 },
        { "id": "operation-canceled", "kind": "support", "attachedTo": "cancellation-token", "lane": 5 },
        { "id": "async-void-errors", "kind": "support", "attachedTo": "async-await", "lane": 6 },
        { "id": "fire-and-forget-task", "kind": "support", "attachedTo": "async-await", "lane": 7 },
        { "id": "task-result-sync-blocking", "kind": "support", "attachedTo": "async-await", "lane": 8 },
        { "id": "cancel-without-awaiting", "kind": "support", "attachedTo": "cancellation-token", "lane": 9 }
      ]
    },
