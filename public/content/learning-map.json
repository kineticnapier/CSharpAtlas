        { "id": "exception-dispatch-info-rethrow", "code": "ExceptionDispatchInfo.Capture(ex).Throw();", "prerequisites": ["try-catch"], "lane": 3 },
        { "id": "nullable", "code": "string? name = null;", "prerequisites": ["try-catch"], "lane": 0 },
        { "id": "nullable-value-types", "code": "int? count = null;", "prerequisites": ["nullable"], "lane": 0 },
        { "id": "pattern-matching", "code": "if (value is int n) { ... }", "prerequisites": ["nullable"], "lane": 2 },
        { "id": "argument-null", "kind": "support", "attachedTo": "nullable", "lane": 3 },
        { "id": "nullref", "kind": "support", "attachedTo": "nullable", "lane": 4 },
        { "id": "cs8602-possible-null", "kind": "support", "attachedTo": "nullable", "lane": 5 },
        { "id": "format-exception", "kind": "support", "attachedTo": "try-catch", "lane": 6 },
        { "id": "invalid-cast", "kind": "support", "attachedTo": "pattern-matching", "lane": 7 },
        { "id": "exception-rethrow", "kind": "support", "attachedTo": "try-catch", "lane": 8 }
