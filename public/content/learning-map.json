        { "id": "jsondocument-dispose", "code": "using var doc = JsonDocument.Parse(json);", "prerequisites": ["json-write"], "lane": 2 },
        { "id": "http-get", "code": "await client.GetStringAsync(url);", "prerequisites": ["idisposable"], "lane": 3 },
        { "id": "httpclient-reuse", "code": "static readonly HttpClient Client = new();", "prerequisites": ["http-get"], "lane": 3 },
        { "id": "io-exception", "kind": "support", "attachedTo": "file-write", "lane": 4 },
        { "id": "directory-not-found", "kind": "support", "attachedTo": "directory-enumerate", "lane": 5 },
        { "id": "unauthorized-access", "kind": "support", "attachedTo": "file-write", "lane": 6 },
        { "id": "object-disposed", "kind": "support", "attachedTo": "idisposable", "lane": 7 },
        { "id": "json-reference-cycles", "kind": "support", "attachedTo": "json-write", "lane": 8 },
        { "id": "json-case-sensitive-properties", "kind": "support", "attachedTo": "json-write", "lane": 9 }
