{
  "chapters": [
    {
      "id": "basics",
      "title": { "ja": "C# 基礎", "en": "C# Basics" },
      "description": { "ja": "変数、条件分岐、ループ、メソッド、配列まで。まずここから。", "en": "Variables, control flow, methods, and arrays. Start here." },
      "nodes": [
        { "id": "program-entry", "code": "Console.WriteLine(\"Hello, World!\");", "lane": 1 },
        { "id": "variables-assignment", "code": "int a = 10;", "prerequisites": ["program-entry"], "lane": 1 },
        { "id": "numeric-types", "code": "double x = 3.14;", "prerequisites": ["variables-assignment"], "lane": 0 },
        { "id": "boolean-operators", "code": "bool ok = a > 0 && b > 0;", "prerequisites": ["variables-assignment"], "lane": 2 },
        { "id": "if-else", "code": "if (score >= 60) { ... }", "prerequisites": ["boolean-operators"], "lane": 2 },
        { "id": "while-do-loops", "code": "while (i < 10) { i++; }", "prerequisites": ["if-else"], "lane": 3 },
        { "id": "methods-parameters-returns", "code": "int Add(int a, int b) => a + b;", "prerequisites": ["variables-assignment"], "lane": 1 },
        { "id": "arrays-basics", "code": "int[] nums = { 1, 2, 3 };", "prerequisites": ["while-do-loops", "methods-parameters-returns"], "lane": 1 },
        { "id": "string-literals", "code": "string name = \"Alice\";", "prerequisites": ["variables-assignment"], "lane": 4 },
        { "id": "index-out-of-range", "kind": "support", "attachedTo": "arrays-basics", "lane": 3 },
        { "id": "floating-equality", "kind": "support", "attachedTo": "numeric-types", "lane": 5 },
        { "id": "integer-overflow", "kind": "support", "attachedTo": "numeric-types", "lane": 6 },
        { "id": "empty-statement-loop", "kind": "support", "attachedTo": "while-do-loops", "lane": 7 }
      ]
    },
    {
      "id": "types-oop",
      "title": { "ja": "型・クラス設計", "en": "Types & Object Design" },
      "description": { "ja": "参照型、プロパティ、record、interface、ジェネリックなど、C# の型設計を学ぶ。", "en": "Reference types, properties, records, interfaces, generics, and object design." },
      "nodes": [
        { "id": "value-reference-types", "code": "int n = 1; Person p = new();", "lane": 1 },
        { "id": "properties", "code": "public string Name { get; set; }", "prerequisites": ["value-reference-types"], "lane": 0 },
        { "id": "required-members", "code": "public required string Name { get; init; }", "prerequisites": ["properties"], "lane": 0 },
        { "id": "records", "code": "record Person(string Name, int Age);", "prerequisites": ["properties"], "lane": 1 },
        { "id": "record-with-expression", "code": "var older = person with { Age = person.Age + 1 };", "prerequisites": ["records"], "lane": 1 },
        { "id": "interfaces", "code": "class Cat : IAnimal { ... }", "prerequisites": ["value-reference-types"], "lane": 2 },
        { "id": "generics", "code": "List<int> numbers = new();", "prerequisites": ["interfaces"], "lane": 2 },
        { "id": "generic-constraints-design", "code": "T Max<T>(T a, T b) where T : IComparable<T> => a.CompareTo(b) >= 0 ? a : b;", "prerequisites": ["generics"], "lane": 2 },
        { "id": "equality-comparer-design", "code": "var users = new HashSet<string>(StringComparer.OrdinalIgnoreCase);", "prerequisites": ["generics"], "lane": 3 },
        { "id": "delegates", "code": "Func<int, int> f = x => x * 2;", "prerequisites": ["value-reference-types"], "lane": 4 },
        { "id": "events", "code": "button.Click += OnClick;", "prerequisites": ["delegates"], "lane": 4 },
        { "id": "pattern-matching", "code": "if (obj is string s) { ... }", "prerequisites": ["value-reference-types"], "lane": 3 },
        { "id": "invalid-cast", "kind": "support", "attachedTo": "pattern-matching", "lane": 5 },
        { "id": "reference-equality", "kind": "support", "attachedTo": "value-reference-types", "lane": 6 },
        { "id": "record-shallow-copy", "kind": "support", "attachedTo": "records", "lane": 7 }
      ]
    },
    {
      "id": "collections-linq",
      "title": { "ja": "コレクション・LINQ", "en": "Collections & LINQ" },
      "description": { "ja": "List、HashSet、IEnumerable、ラムダ式から LINQ へ進む。", "en": "Move from List, HashSet, IEnumerable, and lambdas into LINQ." },
      "nodes": [
        { "id": "list-basic", "code": "var list = new List<int> { 1, 2, 3 };", "lane": 1 },
        { "id": "hashset-basic", "code": "var set = new HashSet<int>();", "prerequisites": ["list-basic"], "lane": 0 },
        { "id": "ienumerable", "code": "IEnumerable<int> xs = list;", "prerequisites": ["list-basic"], "lane": 2 },
        { "id": "lambda", "code": "x => x * 2", "prerequisites": ["ienumerable"], "lane": 2 },
        { "id": "list-filter", "code": "var even = list.Where(x => x % 2 == 0);", "prerequisites": ["lambda"], "lane": 1 },
        { "id": "linq-select", "code": "var names = users.Select(x => x.Name);", "prerequisites": ["lambda"], "lane": 3 },
        { "id": "linq-deferred", "code": "var query = list.Where(x => x > 0);", "prerequisites": ["list-filter", "linq-select"], "lane": 2 },
        { "id": "enumerable-chunk-batching", "code": "foreach (var batch in items.Chunk(100)) Process(batch);", "prerequisites": ["linq-deferred"], "lane": 0 },
        { "id": "linq-groupby", "code": "var groups = items.GroupBy(x => x.Category);", "prerequisites": ["linq-deferred"], "lane": 1 },
        { "id": "linq-countby", "code": "var counts = words.CountBy(word => word);", "prerequisites": ["linq-groupby"], "lane": 1 },
        { "id": "linq-distinct", "code": "var unique = list.Distinct();", "prerequisites": ["hashset-basic", "linq-deferred"], "lane": 3 },
        { "id": "enumerable-distinctby", "code": "var uniqueUsers = users.DistinctBy(user => user.Id);", "prerequisites": ["linq-distinct"], "lane": 3 },
        { "id": "invalid-operation", "kind": "support", "attachedTo": "linq-deferred", "lane": 4 },
        { "id": "deferred-enumeration", "kind": "support", "attachedTo": "linq-deferred", "lane": 5 },
        { "id": "multiple-enumeration-side-effects", "kind": "support", "attachedTo": "linq-deferred", "lane": 6 },
        { "id": "collection-modified-enumeration", "kind": "support", "attachedTo": "ienumerable", "lane": 7 },
        { "id": "mutable-hash-keys", "kind": "support", "attachedTo": "hashset-basic", "lane": 8 }
      ]
    },
    {
      "id": "exceptions-debugging",
      "title": { "ja": "例外・デバッグ", "en": "Exceptions & Debugging" },
